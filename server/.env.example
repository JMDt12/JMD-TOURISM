# Copy to .env and fill in as you go. Everything here is optional in dev.

# Database: unset uses a local SQLite file (server/data/braj.db)
# DATABASE_URL=postgres://user:pass@localhost:5432/braj
# Supabase: use the Session pooler string (Connect > Connection string), not
# the direct db.<ref>.supabase.co one, which needs IPv6. TLS is switched on
# automatically for any non-local host.

PORT=4000
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_URL=http://localhost:5173

# REQUIRED IN PRODUCTION - the server will not start without it when
# NODE_ENV=production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# JWT_SECRET=

# Staff password written by `npm run seed`. Unset: demo1234 on SQLite, a
# random one (printed once) on Postgres.
# SEED_PASSWORD=

# Number of proxies in front of the server once hosted (usually 1), so login
# throttling sees each visitor's own address rather than the proxy's.
# TRUST_PROXY=1

# Payments: sandbox until PAYMENTS_MODE=live AND keys are present
# PAYMENTS_MODE=live
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# WhatsApp Business Cloud API - messages are logged until both are set
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=

# Email fallback
# SMTP_URL=

# The public domain. robots.txt and sitemap.xml build absolute URLs from it,
# so set this before launch or crawlers get localhost links.
# SITE_URL=https://jmdtourism.in

# Maps - without a key the client renders its own SVG map
# GOOGLE_MAPS_API_KEY=

# Set to off to stop the demo GPS simulator
# SIMULATE_TRIPS=off
