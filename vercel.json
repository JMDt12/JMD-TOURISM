{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://jmd-tourism-api.onrender.com/api/:path*" },
    { "source": "/robots.txt", "destination": "https://jmd-tourism-api.onrender.com/robots.txt" },
    { "source": "/sitemap.xml", "destination": "https://jmd-tourism-api.onrender.com/sitemap.xml" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
